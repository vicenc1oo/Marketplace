# Shared configuration for Docker Compose and the backend.
# Copy this file to .env and replace the development-only values as needed.

NODE_ENV=development

BACKEND_PORT=3000
API_PREFIX=/api
CORS_ORIGIN=https://localhost:8443

DB_HOST=postgres
DB_PORT=5432
DB_NAME=marketplace
DB_USER=marketplace

GROQ_MODEL=openai/gpt-oss-20b

AI_MAX_OUTPUT_TOKENS=400
AI_TIMEOUT_MS=12000
AI_MAX_RETRIES=1