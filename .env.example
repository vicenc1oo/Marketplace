# Shared configuration for Docker Compose and the backend.
# Copy this file to .env and replace the development-only values as needed.

NODE_ENV=development

BACKEND_PORT=3000
API_PREFIX=/api
CORS_ORIGIN=https://localhost:8443

DB_HOST=postgres
DB_PORT=5432
DB_NAME=marketplace
DB_USER=marketplace
DB_PASSWORD=change_this_database_password

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN_SECONDS=604800
