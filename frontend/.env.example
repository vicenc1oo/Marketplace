# Base URL of the backend HTTP API (no trailing slash).
# All requests in src/services go through this.
VITE_API_URL=http://localhost:3000/api

# Base URL of the WebSocket server (socket.io) used for chat, bidding and
# notifications. Usually the backend origin without the /api suffix.
VITE_WS_URL=http://localhost:3000

# When "true", the services return local mock data instead of calling the
# backend. Useful while the backend is still being built. Set to "false"
# (or remove) once the real API is available.
VITE_USE_MOCKS=true
